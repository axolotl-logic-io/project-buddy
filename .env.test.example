# Settings for the end-to-end tests. Copy to .env.test, which git ignores.
# `npm run test:e2e` and the `npm run test-db:*` commands load it; the app and
# the other commands never do. Every value is for tests only: never put the
# real passphrase, secret or a Neon connection string here.

# The test database: Postgres in Docker behind Neon's local proxy on port 4444
# (compose.test-db.yml). Only a database on localhost or 127.0.0.1 is
# accepted, and `npm run test-db:reset` drops and recreates the one named
# here. Worktrees that run the tests at the same time each name their own.
DATABASE_URL=postgres://postgres:postgres@localhost:4444/project_buddy_e2e

# The port the tests serve the app on. Worktrees that run the tests at the
# same time each need their own.
E2E_PORT=3100

# The passphrase the sign-up tests type, and the key that signs sessions.
SITE_PASSPHRASE=e2e-test-passphrase
SESSION_SECRET=e2e-test-session-secret

# The tutor answers with its deterministic mock model, never with Claude.
TUTOR_MODEL=mock

# The site writes each email it sends to a JSON file in this folder instead
# of sending it through Resend, and the tests read the sign-in links there
# (e2e/outbox.ts). The tests refuse to run with any other transport.
# Playwright empties test-results/ at the start of every run.
EMAIL_TRANSPORT=outbox
EMAIL_OUTBOX_DIR=test-results/email-outbox
