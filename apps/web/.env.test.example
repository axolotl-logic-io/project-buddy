# Settings for the end-to-end and server tests. Copy to .env.test, which git
# ignores. `npm run test:e2e`, `npm run test:server` and the
# `npm run test-db:*` commands load it; the app and the other commands never
# do. Every value is for tests only: never put the
# real invite code, secret or a Neon connection string here.

# The test server: Postgres in Docker behind Neon's local proxy on port 4444
# (compose.test-db.yml), with its user and password. Only a server on
# localhost or 127.0.0.1 is accepted. Each run of `npm run test:server` or
# `npm run test:e2e` creates a database of its own there, migrates it and
# drops it when it ends, so runs at once, in one checkout or more, never
# meet.
DATABASE_URL=postgres://postgres:postgres@localhost:4444
# Naming a database pins it: each run then resets that one from empty and
# keeps it, and `npm run test-db:reset` and `npm run test-db:reindex`, which
# need a name, work on it. Two runs at once must not share a pinned name.
# Pin a plain name, not one shaped like a run's own,
# project_buddy_e2e_<pid>_<hex>, which a later run drops once that process
# has ended.
# DATABASE_URL=postgres://postgres:postgres@localhost:4444/project_buddy_e2e

# The port the tests serve the app on. Unset, each run takes a free one;
# setting it pins it.
# E2E_PORT=3100

# The invite code the sign-up tests type, and the key that signs sessions.
INVITE_CODE=e2e-test-invite-code
SESSION_SECRET=e2e-test-session-secret

# The tutor answers with its deterministic mock model, never with Claude.
TUTOR_MODEL=mock

# The site writes each email it sends to a JSON file in this folder instead
# of sending it through Resend, and the tests read the sign-in links there
# (e2e/outbox.ts). The tests refuse to run with any other transport.
# Playwright empties test-results/ at the start of every run.
EMAIL_TRANSPORT=outbox
EMAIL_OUTBOX_DIR=test-results/email-outbox
