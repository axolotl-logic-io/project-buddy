# The orchestrator provides .env.test with a database and E2E_PORT pinned to its
# lane. Test commands only consume that file: they never copy this example,
# allocate a database/port or tear down reusable lane resources on exit.
# For a manual run, `npm run test-env:init` writes .env.test from this example
# with a database and site port of this worktree's own. Or copy it by hand, configure a local
# test database and an unused site port, then run npm run test-db:up.
# Never share a manual database/port or a lane between simultaneous runs.
# npm run test:playwright -- <file> runs one e2e file without server tests.
# npm run test:e2e runs test:server followed by test:playwright; server tests
# reset and migrate the configured database first, preserving the resources.
# Only localhost/127.0.0.1, safe database names, mock tutor and file email outbox
# pass the safety guard. The example's credentials are for the local test server.
# Merging these scripts does not install/configure pipeline lane-slot wiring.
DATABASE_URL=postgres://postgres:postgres@localhost:4444/project_buddy_e2e
E2E_PORT=3100
INVITE_CODE=e2e-test-invite-code
SESSION_SECRET=e2e-test-session-secret
TUTOR_MODEL=mock
EMAIL_TRANSPORT=outbox
EMAIL_OUTBOX_DIR=test-results/email-outbox
