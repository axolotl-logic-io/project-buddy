// The site's Biome config. It extends the root biome.jsonc, which holds the
// lint policy, and adds the scoped overrides for the site's files. Globs here
// resolve from this folder.
{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": "//",
  "files": {
    "ignoreUnknown": true,
    // drizzle/meta is rewritten by drizzle-kit on every generate.
    "includes": ["**", "!AGENTS.md", "!drizzle/meta", "!design"]
  },
  "overrides": [
    // Subprocess fixtures use the platform's environment variable names.
    {
      "includes": ["test/component-integration/scripts/development/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "PATH|NODE_NO_WARNINGS|NODE_ENV|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    // The overrides below are the only exceptions to the policy. Each covers a
    // pattern that the framework or tool documents as the way to use it, and
    // names the exact files that need it.

    // Next.js finds a route's UI through the default export of these special
    // files, and Next, drizzle-kit, Playwright and Vitest read their config
    // from a default export.
    {
      "includes": [
        "src/app/**/default.tsx",
        "src/app/**/error.tsx",
        "src/app/**/forbidden.tsx",
        "src/app/**/layout.tsx",
        "src/app/**/loading.tsx",
        "src/app/**/not-found.tsx",
        "src/app/**/page.tsx",
        "src/app/**/template.tsx",
        "src/app/**/unauthorized.tsx",
        "src/app/global-error.tsx",
        "src/app/global-not-found.tsx",
        "src/app/manifest.ts",
        "*.config.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },

    // Next's Metadata API and route segment config: layouts and pages
    // export `metadata`, `generateMetadata`, `viewport` or `instant` next to
    // their component.
    {
      "includes": [
        "src/app/**/layout.tsx",
        "src/app/**/page.tsx",
        "src/app/global-not-found.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": {
              "level": "error",
              "options": {
                "allowExportNames": [
                  "metadata",
                  "generateMetadata",
                  "viewport",
                  "instant"
                ]
              }
            }
          }
        }
      }
    },

    // The site frame uses Tailwind
    // utilities like every other file. These rules follow imports, so they
    // check only the root layouts' document, the frame it renders (header, the site
    // panel, its appearance choices, experience feedback and Quick Add) and
    // the global CSS files whose classes pages use.
    {
      "includes": [
        "src/app/site-document.tsx",
        "src/components/page-header.tsx",
        "src/components/site-panel.tsx",
        "src/components/close-panel-around.ts",
        "src/components/experience/experience-feedback.tsx",
        "src/components/experience/progress-ring.tsx",
        "src/components/ui/progress-arc.tsx",
        "src/components/appearance-choices.tsx",
        "src/components/quick-add.tsx",
        "src/components/ui/field.tsx",
        "src/components/ui/form-message.tsx",
        "src/app/page-roles.css",
        "src/components/performances.css",
        "src/components/constructs/construct-discovery.css",
        "src/components/constructs/construct-art.css"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noUndeclaredClasses": "off",
            "noUnusedClasses": "off"
          }
        }
      }
    },

    // Playwright names its `baseURL` option; the config defines no other
    // name outside the convention.
    {
      "includes": ["playwright.config.ts", "test/audit/browser.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "baseURL|browserURL|extraHTTPHeaders|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    },

    // The audit's Node entry point, reporter and browser use local files and
    // the command's process environment. Playwright loads the reporter by
    // its default export.
    {
      "includes": [
        "test/audit/browser.ts",
        "test/audit/command.ts",
        "test/audit/results.ts",
        "test/audit/reporter.ts",
        "test/audit/run-options.ts"
      ],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" }
        }
      }
    },
    {
      "includes": ["test/audit/command.ts", "test/audit/run-options.ts"],
      "linter": {
        "rules": {
          "style": { "noProcessEnv": "off" }
        }
      }
    },
    {
      "includes": ["test/audit/reporter.ts"],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off" }
        }
      }
    },

    // Chromium's active debugging port filename triggers the entropy
    // heuristic. This boundary reads the browser-generated filename.
    {
      "includes": ["test/audit/browser.ts"],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": {
              "level": "error",
              "options": { "entropyThreshold": 50 }
            }
          }
        }
      }
    },
    // Swap measurements use rendered text and exclude hidden DOM content.
    {
      "includes": ["test/audit/observations.ts"],
      "linter": {
        "rules": {
          "nursery": { "useDomNodeTextContent": "off" }
        }
      }
    },
    // The CLI passes validated options to the Playwright worker environment.
    {
      "includes": ["test/audit/command.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "BUDDY_AUDIT|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    },

    // The web app manifest's members, as the standard names them, returned
    // by Next's manifest file convention.
    {
      "includes": ["src/app/manifest.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "short_name|start_url|background_color|theme_color|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    },

    // Process environment names are SCREAMING_CASE by platform convention:
    // `emailFromAddressEnvironment` builds the server sender setting, and the
    // test suites' and the development server's settings are built too.
    {
      "includes": [
        "src/env.ts",
        "scripts/dev.ts",
        "scripts/test-env/suite-environment.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "DATABASE_URL|EMAIL_FROM_ADDRESS|EMAIL_TRANSPORT|EMAIL_OUTBOX_DIR|SESSION_SECRET|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    },

    // The platform boundary: the only files that touch the process or the
    // console, so that all other code depends on them through plain
    // functions.

    // The one module that reads environment variables. Next.js and Vercel
    // provide them only as the global `process.env`.
    {
      "includes": ["src/env.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },

    // The app's error log. Vercel collects function logs from the console.
    {
      "includes": ["src/errors/error-log.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },

    // Everything in scripts/ is a Node command behind a mise task, or a
    // module only those commands and the test configs import: they use
    // Node's platform APIs and process settings and report on the terminal.
    // None is imported by the site.
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" },
          "style": { "noProcessEnv": "off" },
          "suspicious": { "noConsole": "off" }
        }
      }
    },

    // Vitest and Playwright load reporters and global setup through the
    // default export.
    {
      "includes": ["scripts/test-env/*-failures.ts", "vitest.server-reset.ts"],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off" }
        }
      }
    },

    // The development and database commands are tested in child processes
    // and temporary repositories, using Node platform APIs.
    {
      "includes": [
        "test/component-integration/scripts/development/*.test.ts",
        "test/component-integration/scripts/db/*.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },

    // `mise run ops:query` is tested the same way, with its env file in a
    // temporary directory that the child's environment names.
    {
      "includes": [
        "test/component-integration/scripts/ops/query.server.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },

    // The tests' email transport writes each email to a file, and the tests
    // read them: src/email/outbox.ts and test/support/email/outbox-files.ts,
    // the smallest platform boundary for that file access, use
    // node:fs/promises and node:path. Only src/email/send-email.ts imports
    // the first.
    {
      // The derivative tests read committed artwork.
      "includes": [
        "src/email/outbox.ts",
        "test/support/email/outbox-files.ts",
        "test/component-integration/constructs/visual-delivery.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },

    // HTML's `blocking="render"` attribute, which Biome's attribute list
    // lacks, lets the root layouts' expect link hold the first frame.
    {
      "includes": ["src/app/site-document.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": {
              "level": "error",
              "options": { "ignore": ["blocking"] }
            }
          }
        }
      }
    },

    // Retirement tests execute the public worker in its own Node VM context.
    {
      "includes": [
        "test/component-integration/app/retire-service-worker.test.ts"
      ],
      "linter": { "rules": { "correctness": { "noNodejsModules": "off" } } }
    }
  ]
}
