// The site's Biome config. It extends the root biome.jsonc, which holds the
// lint policy, and adds the scoped overrides for the site's files. Globs here
// resolve from this folder.
{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": "//",
  "files": {
    "ignoreUnknown": true,
    // drizzle/meta is rewritten by drizzle-kit on every generate.
    "includes": ["**", "!AGENTS.md", "!drizzle/meta"]
  },
  "overrides": [
    // TypeScript globalThis augmentation requires ambient var declarations inside
    // declare global. They emit no runtime declarations to hoist.
    {
      "includes": ["scripts/performance/observe.mts"],
      "linter": { "rules": { "nursery": { "useVarsOnTop": "off" } } }
    },
    // The capture uses Puppeteer ElementHandles; Playwright's locator API is different.
    {
      "includes": ["scripts/performance/capture.mts"],
      "linter": {
        "rules": { "nursery": { "noPlaywrightElementHandle": "off" } }
      }
    },

    // The opt-in audit owns local child processes, browser traces and artifacts.
    // These command boundaries use Node filesystem/process APIs and print only progress.
    {
      "includes": [
        "scripts/performance/run.mts",
        "scripts/performance/seed-command.mts",
        "scripts/performance/capture.mts",
        "scripts/performance/lighthouse.mts",
        "scripts/performance/validate.mts",
        "scripts/performance/validate-output.mts",
        "test/component-integration/scripts/performance/compressed.test.mts",
        "test/component-integration/scripts/performance/audit-directory.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" },
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    // Screenshot arguments use the DevTools trace wire field names.
    {
      "includes": ["scripts/performance/capture.mts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "expected_display_time|frame_sequence|source_id|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    },

    // DevTools screenshot metadata uses these wire names in archived traces.
    {
      "includes": ["scripts/performance/artifacts.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "expected_display_time|frame_sequence|source_id|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Server audit attribution needs Node's async context across parallel
    // database work. This is the only platform boundary for that context.
    {
      "includes": ["src/performance/query-counter.ts"],
      "linter": { "rules": { "correctness": { "noNodejsModules": "off" } } }
    },
    // The deterministic Stripe gateway runs one loopback HTTP server per file.
    {
      "includes": [
        "test/component-integration/batteries/checkout.server.test.ts"
      ],
      "linter": { "rules": { "correctness": { "noNodejsModules": "off" } } }
    },

    // Stripe's wire fields are snake_case. Keep the documented names at
    // the provider boundary and in its payment fixtures.
    {
      "includes": [
        "src/batteries/purchases.ts",
        "test/component-integration/batteries/purchases.server.test.ts",
        "test/component-integration/batteries/checkout.server.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "has_more|unit_amount|adaptive_pricing|automatic_tax|payment_status|amount_total|client_reference_id|payment_intent|allowed_payment_method_types|line_items|success_url|cancel_url|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    },

    // The overrides below are the only exceptions to the policy. Each covers a
    // pattern that the framework or tool documents as the way to use it, and
    // names the exact files that need it.

    // Next.js finds a route's UI through the default export of these special
    // files, and Next, drizzle-kit, Playwright and Vitest read their config
    // from a default export.
    {
      "includes": [
        "src/app/**/default.tsx",
        "src/app/**/error.tsx",
        "src/app/**/forbidden.tsx",
        "src/app/**/layout.tsx",
        "src/app/**/loading.tsx",
        "src/app/**/not-found.tsx",
        "src/app/**/page.tsx",
        "src/app/**/template.tsx",
        "src/app/**/unauthorized.tsx",
        "src/app/global-error.tsx",
        "src/app/global-not-found.tsx",
        "src/app/manifest.ts",
        "*.config.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },

    // Next's Metadata API and route segment config: layouts and pages
    // export `metadata`, `generateMetadata`, `viewport` or `instant` next to
    // their component.
    {
      "includes": ["src/app/**/layout.tsx", "src/app/**/page.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": {
              "level": "error",
              "options": {
                "allowExportNames": [
                  "metadata",
                  "generateMetadata",
                  "viewport",
                  "instant"
                ]
              }
            }
          }
        }
      }
    },

    // The site frame uses Tailwind
    // utilities like every other file. These rules follow imports, so they
    // check only the root layout, the frame it renders (header, the site
    // menu and its appearance choices) and the global CSS files whose
    // classes pages use.
    {
      "includes": [
        "src/app/layout.tsx",
        "src/components/site-header.tsx",
        "src/components/site-menu.tsx",
        "src/components/appearance-choices.tsx",
        "src/app/page-roles.css",
        "src/components/chat/chat.css",
        "src/components/constructs/construct-discovery.css"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noUndeclaredClasses": "off",
            "noUnusedClasses": "off"
          }
        }
      }
    },

    // Playwright names its `baseURL` option; the config defines no other
    // name outside the convention.
    {
      "includes": ["playwright.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "baseURL|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    },

    // The web app manifest's members, as the standard names them, returned
    // by Next's manifest file convention.
    {
      "includes": ["src/app/manifest.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "short_name|start_url|background_color|theme_color|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    },

    // web-push's time-to-live option, which it names after the Web Push
    // protocol's TTL header: set in send-push-notification.ts.
    {
      "includes": ["src/push/send-push-notification.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "TTL|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    },

    // Anthropic's usage fields, as its API names them
    // (`providerMetadata.anthropic.usage`): read in anthropic-usage.ts.
    {
      "includes": ["src/quota/anthropic-usage.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "input_tokens|cache_read_input_tokens|cache_creation_input_tokens|cache_creation|ephemeral_5m_input_tokens|ephemeral_1h_input_tokens|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    },

    // Process environment names are SCREAMING_CASE by platform convention,
    // and `emailFromAddressEnvironment` builds the server sender setting.
    {
      "includes": ["src/env.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "DATABASE_URL|EMAIL_FROM_ADDRESS|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    },

    // The platform boundary: the only files that touch the process or the
    // console, so that all other code depends on them through plain
    // functions.

    // The one module that reads environment variables. Next.js and Vercel
    // provide them only as the global `process.env`.
    {
      "includes": ["src/env.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },

    // The app's error log. Vercel collects function logs from the console.
    {
      "includes": ["src/errors/error-log.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },

    // The reindex command's entry point prints its progress to the terminal.
    {
      "includes": ["scripts/reindex-manual.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },

    // The test database commands' entry points print their progress to the
    // terminal.
    {
      "includes": ["scripts/test-db/reindex.ts", "scripts/test-db/reset.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },

    // The release workflow's smoke test command prints the failed checks and
    // sets its exit status, which only Node's node:process can do; it takes
    // the site's URL from its arguments. The build's font check
    // (`npm run check:build-fonts`) is a command too: it reads the built CSS
    // with node:fs, prints each drift and sets its exit status.
    {
      "includes": [
        "scripts/release/smoke.ts",
        "scripts/check-build-font-urls.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },

    // The read-only production query command (`npm run ops:query`) reads
    // the environment file that `npm run ops:env` pulled outside the checkout,
    // not the app's settings, so it reads node:fs and its own directory
    // setting rather than src/env.ts, prints the rows and sets its exit status.
    {
      "includes": ["scripts/ops/query.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },

    // The test database reset's refusals are tested by running the real
    // command in a child process (test/component-integration/scripts/test-db/reset-refusals.test.ts),
    // which only node:child_process can start.
    {
      "includes": [
        "test/component-integration/scripts/test-db/reset-refusals.test.ts",
        "test/component-integration/scripts/performance/archives.test.ts",
        "test/component-integration/scripts/performance/fixture-command.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },

    // `npm run ops:query` is tested the same way, with its env file in a
    // temporary directory that the child's environment names.
    {
      "includes": [
        "test/component-integration/scripts/ops/query.server.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },

    // A test of a migration builds a database as an older release left it,
    // from a temporary copy of drizzle/ whose journal stops early:
    // scripts/test-db/old-migrations.ts is the one file that makes that copy.
    {
      "includes": ["scripts/test-db/old-migrations.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },

    // The tests' email transport writes each email to a file, and the tests
    // read them: src/email/outbox.ts and test/support/email/outbox-files.ts,
    // the smallest platform boundary for that file access, use
    // node:fs/promises and node:path. Only src/email/send-email.ts imports
    // the first.
    {
      // The visual reference loader and derivative tests read committed artwork.
      "includes": [
        "src/email/outbox.ts",
        "test/support/email/outbox-files.ts",
        "src/constructs/visual-reference.ts",
        "test/component-integration/constructs/visual-delivery.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },

    // The push notification tests' fake push service is an HTTP server on
    // loopback, which only node:http can start, and its fake browsers
    // decrypt what the site sent them with node:crypto, as a browser does.
    {
      "includes": [
        "test/component-integration/push/fake-push-service-test-kit.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },

    // The push notification tests run the service worker, public/sw.js, in
    // a context of its own, which only node:vm makes, after reading it with
    // node:fs/promises. Its fake PushSubscription has the method the
    // browser's has, toJSON.
    {
      "includes": [
        "test/component-integration/push/service-worker-test-kit.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "selector": { "kind": "objectLiteralProperty" },
                    "match": "toJSON|(.+)"
                  },
                  {
                    "selector": { "kind": "typeProperty" },
                    "match": "toJSON|(.+)"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
