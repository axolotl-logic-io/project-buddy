# Copy to .env.local for local development, or run `vercel env pull .env.local`
# once the Vercel project is linked. Never commit real values.

# Neon Postgres connection string, set by the Neon integration from the Vercel
# Marketplace. Used by the app (src/db/client.ts) and by drizzle-kit
# (drizzle.config.ts) for `npm run db:migrate`. Get the connection string from
# the Neon integration in the Vercel project, or with `vercel env pull`.
DATABASE_URL=

# Anthropic API key for the construct. src/env.ts reads it, and the construct passes it
# to the Vercel AI SDK's Anthropic provider (src/replies/model.ts). Create a key
# in the Anthropic Console.
ANTHROPIC_API_KEY=

# Which model the construct runs. Unset means Claude. "mock" selects a
# deterministic mock that replies in Markdown without calling Anthropic, for
# tests and local development without an API key.
# The earlier name, BUDDY_MODEL, is still read when CONSTRUCT_MODEL is unset.
# CONSTRUCT_MODEL=mock

# The invite code the sign-up page asks for (src/app/signup/actions.ts). Only
# invited people know it. Choose any long, hard-to-guess phrase, and share it
# only with the people you invite.
INVITE_CODE=

# Secret that signs the session cookie (src/auth/session-token.ts). Generate
# one with `openssl rand -base64 32`. Changing it logs out every session.
SESSION_SECRET=

# Secret the scheduler sends to start the constructs' check-ins
# (src/app/api/check-ins/route.ts). Vercel Cron sends it as a bearer token
# when the Vercel project has CRON_SECRET set. Generate one with
# `openssl rand -base64 32`. Unset means no request can start check-ins.
CRON_SECRET=

# Resend API key that sends the sign-in emails (src/email/resend.ts). Create a
# key with send-only access in the Resend dashboard.
RESEND_API_KEY=

# The address the site's emails come from, under Vellum's name
# (src/email/email-message.ts adds it, so give the bare address). It must be
# on a domain verified in Resend, and is required with the Resend transport;
# the outbox transport defaults it to vellum@example.test.
EMAIL_FROM_ADDRESS=vellum@axolotl-logic.io

# How email is sent. Unset means Resend. "outbox" writes each email to a JSON
# file in EMAIL_OUTBOX_DIR instead, for the end-to-end tests, or to sign in
# locally without sending email; production refuses it.
# EMAIL_TRANSPORT=outbox
# EMAIL_OUTBOX_DIR=test-results/email-outbox

# Optional separate image provider. Set through secret controls; never commit a value.
OPENAI_API_KEY=
