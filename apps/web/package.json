{
  "name": "@project-buddy/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --error-on-warnings && npm run typecheck",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "bash scripts/test-env/test.sh",
    "test:doctor": "npx --yes react-doctor@0.9.23 --yes --no-score --no-supply-chain",
    "test:repository": "vitest run --project repository --project vite-integration",
    "test:browser": "npm run browsers:install && vitest run --project 'browser*' --reporter=default --reporter=./scripts/test-env/vitest-failures.ts",
    "test:server": "npm run test-db:reset && node --env-file=.env.test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../../node_modules/vitest/vitest.mjs run --config vitest.server.config.mts",
    "test:system": "npm run test-db:reset && node --env-file=.env.test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../../node_modules/@playwright/test/cli.js test",
    "test:e2e": "bash scripts/test-env/require-env-test.sh && npm run test:browser && npm run test:system --",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev:database": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/development/database.ts",
    "browsers:install": "playwright install chromium webkit",
    "test-env:init": "bash scripts/test-env/init-worktree.sh",
    "test-db:up": "bash scripts/test-env/require-env-test.sh && docker compose --file compose.test-db.yml up --detach --wait",
    "test-db:down": "bash scripts/test-env/require-env-test.sh && docker compose --file compose.test-db.yml down",
    "test-db:reset": "bash scripts/test-env/require-env-test.sh && node --env-file=.env.test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-db/reset.ts",
    "test:build": "bash scripts/test-env/require-env-test.sh && node --env-file=.env.test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --input-type=module -e 'import { checkTestEnvironment } from \"./scripts/test-db/test-database.ts\"; checkTestEnvironment()' && node --env-file=.env.test ../../node_modules/next/dist/bin/next build"
  },
  "dependencies": {
    "@streamdown/code": "2.0.0",
    "@vercel/functions": "^3.11.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.70.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "shiki": "4.5.0",
    "streamdown": "2.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@next/env": "16.4.6",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.1.0",
    "culori": "^4.0.2",
    "drizzle-kit": "^0.31.11",
    "memfs": "^4.80.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "65.16.0",
    "vite": "8.3.4",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  }
}
