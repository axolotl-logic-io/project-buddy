{
  "name": "@project-buddy/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:build-fonts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-build-font-urls.ts",
    "lint": "biome lint --error-on-warnings",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "bash scripts/test-env/require-env-test.sh && npm run test-db:reset && node --env-file=.env.test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../../node_modules/vitest/vitest.mjs run --config vitest.server.config.mts",
    "test:playwright": "bash scripts/test-env/require-env-test.sh && node --env-file=.env.test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../../node_modules/@playwright/test/cli.js test",
    "test:e2e": "npm run test:server && npm run test:playwright --",
    "test:visual": "npm run test:server && npm run test:playwright -- --project=visual*",
    "test:visual:update": "npm run test:visual -- --update-snapshots",
    "test:scripts": "bash ../../.github/scripts/vercel-promote.test.sh && bash scripts/test-env/test-env.test.sh",
    "check": "biome check --error-on-warnings && npm run typecheck && npm run test:scripts && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "manual:reindex": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/reindex-manual.ts",
    "test-db:up": "bash scripts/test-env/require-env-test.sh && bash scripts/test-env/check-neon-proxy.sh && docker compose --file compose.test-db.yml up --detach --wait",
    "test-db:down": "bash scripts/test-env/require-env-test.sh && docker compose --file compose.test-db.yml down",
    "test-db:reset": "bash scripts/test-env/require-env-test.sh && node --env-file=.env.test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-db/reset.ts",
    "test-db:reindex": "bash scripts/test-env/require-env-test.sh && node --env-file=.env.test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-db/reindex.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/provider": "4.0.26",
    "@ai-sdk/react": "^4.0.140",
    "@assistant-ui/react": "0.15.27",
    "@assistant-ui/react-ai-sdk": "1.4.17",
    "@neondatabase/serverless": "^1.2.0",
    "@streamdown/code": "2.0.0",
    "ai": "^7.0.137",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "streamdown": "2.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.4.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "culori": "^4.0.2",
    "drizzle-kit": "^0.31.11",
    "isomorphic-git": "^1.43.3",
    "jsdom": "^30.1.2",
    "memfs": "^4.80.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "64.5.0",
    "vite": "8.3.4",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0"
  }
}
