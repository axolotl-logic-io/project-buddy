#!/bin/busybox sh
/bin/busybox --install -s /bin
export PATH=/bin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

mount_kiosk() {
  mount -t ext4 -o ro,noload "$1" /root || return 1
  if [ ! -f /root/etc/project-buddy-kiosk ]; then
    umount /root
    return 1
  fi
  umount /root && mount -t ext4 "$1" /root
}

unpack_kiosk() {
  [ -f "$1" ] && return 0
  [ -f "$1.gz" ] || return 1
  if gzip -dc "$1.gz" > "$1.unpacking" && sync && mv "$1.unpacking" "$1"; then
    return 0
  fi
  rm -f "$1.unpacking"
  return 1
}

mount_internal_kiosk() {
  # Partition 12 is shared media on the stock first-generation Fire layout.
  [ -b /dev/mmcblk0p12 ] || return 1
  mount -t vfat -o nosuid,nodev,noexec /dev/mmcblk0p12 /media || return 1
  image=/media/ProjectBuddy/kiosk.ext4
  if unpack_kiosk "$image" && loop_device=$(losetup -f) && losetup "$loop_device" "$image"; then
    if mount_kiosk "$loop_device"; then
      # Keep the loop device's backing filesystem mounted across switch_root.
      if mkdir -p /root/mnt/kindle-media && mount -o move /media /root/mnt/kindle-media; then
        return 0
      fi
      umount /root
    fi
    losetup -d "$loop_device"
  fi
  umount /media
  return 1
}

echo 'Looking for the Project Buddy filesystem.'
while :; do
  if mount_internal_kiosk; then
    break
  fi
  for device in /dev/sd[a-z][0-9]* /dev/sd[a-z]; do
    [ -b "$device" ] || continue
    if mount_kiosk "$device"; then
      break 2
    fi
  done
  sleep 2
done
mount -o move /dev /root/dev
mount -o move /proc /root/proc
mount -o move /sys /root/sys
exec switch_root /root /sbin/init
