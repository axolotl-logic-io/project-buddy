# Copy to .env.local for local development, or run `vercel env pull .env.local`
# once the Vercel project is linked. Never commit real values.

# Neon Postgres connection string, set by the Neon integration from the Vercel
# Marketplace. Used by the app (src/db/client.ts) and by drizzle-kit
# (drizzle.config.ts) for `npm run db:migrate`.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Anthropic API key for the tutor. src/env.ts reads it, and the tutor passes it
# to the Vercel AI SDK's Anthropic provider (src/tutor/model.ts).
ANTHROPIC_API_KEY=sk-ant-...

# Which model the tutor runs. Unset means Claude. "mock" selects a
# deterministic mock that replies in Markdown without calling Anthropic, for
# tests and local development without an API key.
# TUTOR_MODEL=mock

# The invite code the sign-up page asks for (src/app/signup/actions.ts). Only
# invited people know it.
INVITE_CODE=choose-a-long-invite-code

# Secret that signs the session cookie (src/auth/session-token.ts). Generate
# one with `openssl rand -base64 32`. Changing it logs out every session.
SESSION_SECRET=replace-with-openssl-rand-base64-32

# Resend API key that sends the sign-in emails (src/email/resend.ts), from
# bot@axolotl-logic.io. Send-only access is enough.
RESEND_API_KEY=re_...

# How email is sent. Unset means Resend. "outbox" writes each email to a JSON
# file in EMAIL_OUTBOX_DIR instead, for the end-to-end tests, or to sign in
# locally without sending email; production refuses it.
# EMAIL_TRANSPORT=outbox
# EMAIL_OUTBOX_DIR=test-results/email-outbox
